# ── API Keys (plug in when ready) ─────────────────────────────────────────────
# At least one of these is needed for AI clip detection.
# Without them the tool uses a smart heuristic engine automatically.

ANTHROPIC_API_KEY=your_anthropic_key_here
OPENAI_API_KEY=your_openai_key_here

# ── Preferred AI Model ─────────────────────────────────────────────────────────
# Options: claude  |  openai  |  auto (tries claude first, falls back to openai)
AI_PROVIDER=auto

# ── Whisper Transcription ──────────────────────────────────────────────────────
# Options: local (free, runs on your machine)  |  openai (faster, needs key)
WHISPER_MODE=local
# Whisper model size: tiny | base | small | medium | large-v3
# Larger = more accurate but slower. "base" is a great starting point.
WHISPER_MODEL=base

# ── Social Media Scheduler ─────────────────────────────────────────────────────
# Uses Ayrshare API — get a free key at https://ayrshare.com
AYRSHARE_API_KEY=your_ayrshare_key_here

# ── App Settings ───────────────────────────────────────────────────────────────
SECRET_KEY=change_this_to_a_random_string
MAX_VIDEO_DURATION=3600
OUTPUT_DIR=./output
PORT=5000
DEBUG=false
